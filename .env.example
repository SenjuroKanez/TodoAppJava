# Copy to .env and set a unique database password before starting Compose.
DATABASE_PASSWORD=replace-with-a-long-random-password
# false is for localhost HTTP only. Use true behind HTTPS in production.
COOKIE_SECURE=false
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
